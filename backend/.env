# ── App ──────────────────────────────────────────────────────
APP_ENV=development                          # development | staging | production
APP_NAME="AI WhatsApp Automation Platform"
APP_SECRET_KEY=2a2f7d1c603bc50b8f5eb4464224185071c33ee5a8f41c4c77aef93a45f70ab8
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=5000
APP_WORKERS=4
APP_LOG_LEVEL=INFO

# ── Database (PostgreSQL) ─────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://whatsapp_user:dev_password@localhost:5432/whatsapp_platform
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=40
DATABASE_POOL_TIMEOUT=30
DATABASE_ECHO=false

# ── Redis ─────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ── WhatsApp Business Cloud API ───────────────────────────────
